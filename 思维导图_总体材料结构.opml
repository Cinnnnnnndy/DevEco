<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>鸿蒙开发者业务 · 现状、创新与业务发展想法</title>
  </head>
  <body>
    <outline text="鸿蒙开发者业务 · 现状、创新与业务发展想法">
      <outline text="01 现状 · 业务基本盘">
        <outline text="四条业务线（合起来才是完整旅程）">
          <outline text="IDE：DevEco Studio · Code · CLI"/>
          <outline text="开发者官网 developer.huawei.com"/>
          <outline text="AGC AppGallery Connect"/>
          <outline text="AG 应用市场（是否纳入今年范围待定）"/>
        </outline>
        <outline text="今年三个变化">
          <outline text="目标转向头部公司，不是中长尾"/>
          <outline text="CodeGenie 下线，Studio 内 AI 入口空出"/>
          <outline text="文档归另一个部门，我们一般不管"/>
        </outline>
        <outline text="两类客户，两种入口">
          <outline text="头部公司：开放能力（Skill / MCP）+ 打包"/>
          <outline text="中小与个人：一站式 GUI（Studio + Code）"/>
        </outline>
        <outline text="版本落地节奏">
          <outline text="9/30 发布 7.0"/>
          <outline text="10 月产品规划节点 + 融合方案汇报"/>
          <outline text="10–11 月 BP 规划"/>
          <outline text="12/30 发布 7.1：DevEco Code 的 GUI 融进 IDE"/>
          <outline text="8.0 → HDC 2027（最重要的版本）"/>
        </outline>
        <outline text="关键角色与运作">
          <outline text="决策链五人 + 产品经理线 + 输入支撑"/>
          <outline text="五个例会：体验例会 → SEG → OSG → TMG → CCB"/>
          <outline text="人员建联地图（前两个月）"/>
        </outline>
        <outline text="业务规划的两个重点">
          <outline text="重点一 · 融合方案（KIT + TUI + IDE）">
            <outline text="为什么融合：三个产品 / 两类客户 / 一种语言 ArkTS"/>
            <outline text="来龙去脉：模式切换 → Agent 工具 → 回到 IDE"/>
            <outline text="三个阶段：CLI 终端工具 → IDE 插件（7.1）→ 深层互动场景（空白）"/>
            <outline text="融合后的体验：装得上 / 调得对 / 看得懂"/>
            <outline text="两个问题：能不能做 Skill · 体验策略三条候选"/>
            <outline text="挑战点：不卷模型，卷鸿蒙平台上的效率提升与体验提效"/>
            <outline text="十月汇报口径：阶段一可演示，阶段二用路线图与原型讲"/>
          </outline>
          <outline text="重点二 · 体验设计七项">
            <outline text="当前版本 · 落地质量（问题闭环）"/>
            <outline text="体验评估：930 基线 → 1030 迭代 → 每版本验收"/>
            <outline text="客户互动 · 舆情跟踪 · 活动支撑"/>
            <outline text="创新（AI · 多设备 · 调优）→ 研究洞察 → 8.0"/>
          </outline>
        </outline>
        <outline text="方向核对：六条前提逐条对证据（A 一手 / B 官方 / C 转述）">
          <outline text="方向本身：融合三产品、走开放能力 + 打包 → A · 成立，证据最硬"/>
          <outline text="大厂只要打包与鸿蒙能力，不要 TUI 与完整 IDE → C · 待核实"/>
          <outline text="三阶段路径是两次调整收敛出来的 → B · 成立，但阶段三空白"/>
          <outline text="卡点在服务对象不在出资方目标范围内 → C · 待核实"/>
          <outline text="DevEco Code 面向中小与个人 → B · 成立"/>
          <outline text="文档站不纳入 → A · 部分成立，官网侧 Agent 入口要纳入"/>
        </outline>
        <outline text="方向矩阵：横轴 对头部公司的价值 × 纵轴 只有平台方能做">
          <outline text="先做：打包签名上架、编译真机、ArkTS 真值、Skills / MCP 接口"/>
          <outline text="留给长尾与后续：多设备预览、调优、GUI 一站式"/>
          <outline text="优先级最低：独立 TUI Agent、自研模型能力"/>
        </outline>
      </outline>
      <outline text="02 创新：研究洞察 → 创新 → 8.0">
        <outline text="节奏：10 月启动 → 10–11 月 BP → 2027 H1 进 8.0"/>
        <outline text="机会空位就是融合方案留白的阶段三"/>
        <outline text="依据">
          <outline text="BUTP 四维分析"/>
          <outline text="冲击有多大：84% 用 AI / 33% 信任 / 65% Gartner"/>
          <outline text="横向拉通三页">
            <outline text="Agent 改代码那一刻：三家界面截图"/>
            <outline text="回退与多任务：Xcode 时间轴 · AS 多会话"/>
            <outline text="十个体验维度打分（不看技术参数）"/>
          </outline>
          <outline text="三条路：开门 · 绕行 · 闭门"/>
          <outline text="竞品雷达 R01：宿主 / 五项及格线 / 平台知识"/>
          <outline text="竞品雷达 R02">
            <outline text="Apple 上架 Google Antigravity → 开放成入场费"/>
            <outline text="华为 llms.txt 已存在但找不到"/>
            <outline text="多文件 diff 窗口以周计"/>
          </outline>
          <outline text="四家官网怎么说 AI：DevEco 在第二层"/>
          <outline text="CodeGenie">
            <outline text="三条判据：不是 Agent，是上一代的副驾"/>
            <outline text="满意度四类原因：代际 / 可用性 / 信任 / 口径"/>
            <outline text="三个缺口会搬到 DevEco Code 上"/>
          </outline>
          <outline text="DevEco 该做什么：执行面 · 真值面 · 治理面"/>
          <outline text="前瞻 12–24 个月：App→Agent · 模型换代 · 看不见的 DevEco"/>
        </outline>
        <outline text="候选创新点四个（对着竞品确认过的空位）">
          <outline text="Agent 执行过程可见与可干预"/>
          <outline text="多文件改动审阅与回退"/>
          <outline text="嵌入式工作流体验"/>
          <outline text="平台知识以 Agent 可消费的形态交付"/>
        </outline>
        <outline text="创新机会点七条 · 按执行面 / 真值面 / 治理面排">
          <outline text="现在到十一月（阶段二）">
            <outline text="① 执行过程可见 + 多文件 diff 审阅 → 红海，窗口以周计"/>
            <outline text="② 平台知识开放成公共 MCP / API + 进采纳名单 → 半蓝海，本季可完成"/>
            <outline text="③ 成本可见 · 阻塞可见 · 会话资产 · 模型身份校验 → 形态已收敛，可照抄"/>
          </outline>
          <outline text="十月后到 8.0（阶段三的空白）">
            <outline text="④ 面向「被集成」场景的原生设计 → 真蓝海，六家都没有这个命题（旗舰论点）"/>
            <outline text="⑤ 企业侧 Agent 治理：托管模型 · 配额 · 白名单 · 审计 → 蓝海"/>
            <outline text="⑥ 构建 / 签名 / 测试脱离 GUI，Linux 优先 → 本方独有短板"/>
          </outline>
          <outline text="远景观察">
            <outline text="⑦ Model Hardware Standard → 先跟踪，不占当前设计资源"/>
          </outline>
        </outline>
      </outline>
      <outline text="03 业务发展想法 · 风险与团队组成">
        <outline text="商业价值：产生的是鸿蒙应用的供给">
          <outline text="1100 万+ 开发者 → 四条线 → 40 万+ 上架应用"/>
          <outline text="每一步流失都是供给的流失"/>
          <outline text="待补：注册到首个应用上架的转化率"/>
        </outline>
        <outline text="产品策略：一句主张，四条策略">
          <outline text="主张：不卷模型，做谁都要经过的那几件事"/>
          <outline text="① 两类客户，两种入口，同一套能力"/>
          <outline text="② 平台方做平台方的事（执行 / 真值 / 治理）"/>
          <outline text="③ 从闭门走向开放"/>
          <outline text="④ 四个触点，一套语言"/>
        </outline>
        <outline text="一年时间线（9/30 · 十月汇报 · 12/30 · HDC 2027）"/>
        <outline text="风险四条">
          <outline text="四条线的覆盖与交接（关注）"/>
          <outline text="差异化窗口以周计（高）"/>
          <outline text="上游依赖 OpenCode 2.0 重写（中）"/>
          <outline text="关键信息尚未对齐（中）"/>
        </outline>
        <outline text="团队组成 · 现状">
          <outline text="组内现有 11 人，按岗位口径写，不含人名与工号"/>
          <outline text="AG 一条线是否纳入今年的范围待定"/>
          <outline text="具体怎么铺，等范围定下来再对齐"/>
        </outline>
        <outline text="需要盼总支持的几件事（本季度内）"/>
      </outline>
    </outline>
  </body>
</opml>
