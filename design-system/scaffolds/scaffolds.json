{
  "version": "1.0.0",
  "source": "Extracted from 【NewUI】鸿蒙IDE-当代.pix, 👉🔥【2.0】基础范式🔥👈.pix, 【TUI】DevEco Code 基础UI规范.pix & DevEco Studio（当代）chat.pix",
  "scaffolds": [
    {
      "id": "ide-workbench",
      "no": "S1",
      "name": "IDE 主工作台脚手架 (Main IDE Workbench)",
      "pixsoSource": "Windows: Main window (1536×960) & 基础范式 2.0",
      "whenToUse": "代码编辑、工程浏览、编译调试、性能剖析等标准 IDE 全窗口页面",
      "defaultSystem": "harmony",
      "defaultTheme": "dark",
      "structure": ".de-window > .de-titlebar + .de-window__body(.de-stripe + .de-nav + .de-main(.de-tabs + .de-code-editor + .de-bottom-pane) + .de-statusbar)",
      "html": "<section class=\"de-window\" style=\"min-height:320px\">\n  <header class=\"de-titlebar\">\n    <span class=\"de-titlebar__mark\">A</span>\n    <button type=\"button\" class=\"de-titlebar__pill\">Healthy_life ▾</button>\n    <button type=\"button\" class=\"de-titlebar__pill\"><svg class=\"de-svg-icon de-svg-icon--s\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#nu-vcs-branch\"/></svg> main ▾</button>\n    <span class=\"de-titlebar__spacer\"></span>\n    <div class=\"de-window__controls\" aria-hidden=\"true\">\n      <button type=\"button\" tabindex=\"-1\"><svg class=\"de-svg-icon\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-工具栏-ic-ide-build\"/></svg></button>\n      <button type=\"button\" tabindex=\"-1\" style=\"color:var(--color-success)\"><svg class=\"de-svg-icon\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-工具栏-ic-ide-play\"/></svg></button>\n      <button type=\"button\" tabindex=\"-1\" style=\"color:var(--color-success)\"><svg class=\"de-svg-icon\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-工具栏-ic-ide-debug\"/></svg></button>\n    </div>\n  </header>\n  <div class=\"de-window__body\">\n    <nav class=\"de-stripe\" aria-label=\"侧边工具条\">\n      <button type=\"button\" class=\"de-icon-button de-icon-button--m\" aria-label=\"Project\" aria-pressed=\"true\"><svg class=\"de-svg-icon\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-工具栏-ic-ide-folder\"/></svg></button>\n      <button type=\"button\" class=\"de-icon-button de-icon-button--m\" aria-label=\"Search\"><svg class=\"de-svg-icon\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#nu-general-search\"/></svg></button>\n      <button type=\"button\" class=\"de-icon-button de-icon-button--m\" aria-label=\"Git\"><svg class=\"de-svg-icon\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#nu-vcs-branch\"/></svg></button>\n    </nav>\n    <aside class=\"de-nav\" aria-label=\"工程目录\" style=\"width:200px\">\n      <div class=\"de-nav__label\">Project</div>\n      <ul class=\"de-tree\">\n        <li>\n          <details class=\"de-tree__node\" open>\n            <summary class=\"de-tree__row\"><span class=\"de-tree__chevron\">›</span><span class=\"de-tree__name\">entry › ets</span></summary>\n            <ul class=\"de-tree__children\">\n              <li><div class=\"de-tree__row\" data-selected=\"true\"><span class=\"de-tree__badge\">A</span><span class=\"de-tree__name\">EntryAbility.ets</span></div></li>\n              <li><div class=\"de-tree__row\"><span class=\"de-tree__badge\" data-ext=\"json\">{}</span><span class=\"de-tree__name\">module.json5</span></div></li>\n            </ul>\n          </details>\n        </li>\n      </ul>\n    </aside>\n    <div class=\"de-main\">\n      <div class=\"de-tabs\" role=\"tablist\">\n        <div class=\"de-tab\" data-selected=\"true\"><button type=\"button\" role=\"tab\" class=\"de-tab__main\" aria-selected=\"true\"><span class=\"de-tree__badge\">A</span> EntryAbility.ets</button></div>\n      </div>\n      <div class=\"de-code-editor\" style=\"flex:1;padding:6px 0\">\n        <div class=\"de-code-line\"><span class=\"de-code-gutter\">1</span><span class=\"de-code-content\"><span class=\"kw\">export default class</span> <span class=\"fn\">EntryAbility</span> {</span></div>\n        <div class=\"de-code-line\" data-current=\"true\"><span class=\"de-code-gutter\">2</span><span class=\"de-code-content\">  onCreate() { Logger.<span class=\"fn\">info</span>(<span class=\"str\">'Ready'</span>); }</span></div>\n        <div class=\"de-code-line\"><span class=\"de-code-gutter\">3</span><span class=\"de-code-content\">}</span></div>\n      </div>\n      <section class=\"de-bottom-pane\" aria-label=\"底部终端面板\">\n        <div class=\"de-bottom-pane__bar\"><span>Terminal · Hvigor Build</span><span class=\"de-tag\">0 Errors</span></div>\n        <div class=\"de-bottom-pane__body\">hvigor Finished :entry:default@CompileArkTS in 1.42s</div>\n      </section>\n      <footer class=\"de-statusbar\">\n        <span class=\"de-crumb\">Healthy_life › <strong>EntryAbility.ets</strong></span>\n        <span class=\"de-lsp-pill\"><span class=\"de-lsp-pill__dot\">2</span> LSP Service</span>\n      </footer>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "ai-chat-workbench",
      "no": "S2",
      "name": "AI Agent / 会话工作台脚手架 (AI Session Workbench)",
      "pixsoSource": "DevEco Studio（当代）chat.pix & 【TUI】基础UI规范.pix (1440×800)",
      "whenToUse": "AI 助手对话、多会话历史列表（Today / 日期分组）、CodeGenie Agent 工作台（严禁在此窗口叠加 .de-studio）",
      "defaultSystem": "pc-mac",
      "defaultTheme": "dark",
      "structure": ".de-window > .de-titlebar + .de-window__body(.de-stripe + .de-nav(.de-nav__label + .de-nav__item) + .de-chat-main(.de-chat-header + .de-chat-feed + .de-chat-composer))",
      "html": "<section class=\"de-window\" style=\"min-height:330px\">\n  <header class=\"de-titlebar\">\n    <span class=\"de-titlebar__mark\">A</span>\n    <button type=\"button\" class=\"de-titlebar__pill\">DevEco Code · AI Agent ▾</button>\n    <span class=\"de-titlebar__spacer\"></span>\n    <button type=\"button\" class=\"de-button de-button--primary de-button--s\"><svg class=\"de-svg-icon de-svg-icon--s\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-ic-ide-add\"/></svg> 新建会话</button>\n  </header>\n  <div class=\"de-window__body\">\n    <nav class=\"de-stripe\" aria-label=\"侧边工具条\">\n      <button type=\"button\" class=\"de-icon-button de-icon-button--m\" aria-label=\"AI 会话\" aria-pressed=\"true\"><svg class=\"de-svg-icon\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#nu-general-tool-windows-aiassistanttoolwindow\"/></svg></button>\n      <button type=\"button\" class=\"de-icon-button de-icon-button--m\" aria-label=\"Project\"><svg class=\"de-svg-icon\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-工具栏-ic-ide-folder\"/></svg></button>\n    </nav>\n    <aside class=\"de-nav\" aria-label=\"历史会话\" style=\"width:216px\">\n      <div class=\"de-nav__label\">Today</div>\n      <button type=\"button\" class=\"de-nav__item\" aria-current=\"page\"><span class=\"de-nav__text\">冷启动主线程耗时优化与 TaskPool 改造</span></button>\n      <button type=\"button\" class=\"de-nav__item\"><span class=\"de-nav__text\">排查 EntryAbility 路由跳转白屏问题</span></button>\n      <div class=\"de-nav__label\">2026/8/30</div>\n      <button type=\"button\" class=\"de-nav__item\"><span class=\"de-nav__text\">ArkTS 6.0 卡片刷新异常日志分析与回滚方案</span></button>\n    </aside>\n    <div class=\"de-chat-main\">\n      <div class=\"de-chat-header\">\n        <strong style=\"font-size:13px\">冷启动主线程耗时优化与 TaskPool 改造</strong>\n        <span class=\"de-ai-status\" data-state=\"generating\"><svg class=\"de-svg-icon de-svg-icon--s\" style=\"color:var(--de-ai-ink)\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-ic-ide-ai填充\"/></svg>生成中</span>\n      </div>\n      <div class=\"de-chat-feed\">\n        <div class=\"de-chat-bubble de-chat-bubble--user\">帮我分析 EntryAbility.ets 冷启动慢的原因，给出 TaskPool 异步补丁。</div>\n        <div class=\"de-chat-bubble\">已定位到 <code>RdbHelper.createTable</code> 在主线程同步阻塞 142ms，建议迁移至 <code>taskpool.execute</code> 后台执行。</div>\n      </div>\n      <div class=\"de-chat-composer\">\n        <div class=\"de-row\">\n          <label class=\"de-input\" style=\"flex:1\"><input type=\"text\" placeholder=\"输入指令，按 Enter 发送或 @ 引用工程文件...\" aria-label=\"AI 对话输入框\"></label>\n          <button type=\"button\" class=\"de-button de-button--primary de-button--m\">发送</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
    },
    {
      "id": "split-settings-dialog",
      "no": "S3",
      "name": "双栏设置 / 新建工程弹窗脚手架 (Settings & Wizard Split Dialog)",
      "pixsoSource": "【NewUI】Dialog / Settings (883×606) & New Project (883×640)",
      "whenToUse": "IDE 全局设置、SDK 管理、新建工程向导、多分类配置弹窗（含纵向分栏时顶部与底部必须保留 1px 分割线）",
      "defaultSystem": "pc-mac",
      "defaultTheme": "light",
      "structure": ".de-split-dialog > .de-split-dialog__header + .de-split-dialog__body(.de-nav + .de-split-dialog__content) + .de-split-dialog__footer",
      "html": "<div class=\"de-split-dialog\" role=\"dialog\" aria-label=\"Settings\">\n  <div class=\"de-split-dialog__header\">\n    <span>Settings · Preferences</span>\n    <span class=\"de-tag\">HarmonyOS SDK 6.0</span>\n  </div>\n  <div class=\"de-split-dialog__body\">\n    <aside class=\"de-nav\" aria-label=\"设置分类\" style=\"width:190px\">\n      <div class=\"de-nav__label\">Appearance</div>\n      <button type=\"button\" class=\"de-nav__item\" aria-current=\"page\"><span class=\"de-nav__text\">Theme &amp; Font</span></button>\n      <button type=\"button\" class=\"de-nav__item\"><span class=\"de-nav__text\">Keymap</span></button>\n      <div class=\"de-nav__label\">Build &amp; SDK</div>\n      <button type=\"button\" class=\"de-nav__item\"><span class=\"de-nav__text\">OpenHarmony SDK</span></button>\n      <button type=\"button\" class=\"de-nav__item\"><span class=\"de-nav__text\">Hvigor Compiler</span></button>\n    </aside>\n    <div class=\"de-split-dialog__content\">\n      <div class=\"de-field\">\n        <span class=\"de-field__label\">Color Theme</span>\n        <span class=\"de-select\"><select aria-label=\"Color Theme\"><option>IntelliJ NewUI Light</option><option>IntelliJ NewUI Dark</option><option>HarmonyOS HDesign 2.0</option></select></span>\n      </div>\n      <div class=\"de-row\">\n        <label class=\"de-choice\"><input type=\"checkbox\" class=\"de-checkbox\" checked><span>Sync with OS theme</span></label>\n        <label class=\"de-choice\"><input type=\"checkbox\" role=\"switch\" class=\"de-switch\" checked><span>Enable ArkTS Linter</span></label>\n      </div>\n    </div>\n  </div>\n  <div class=\"de-split-dialog__footer\">\n    <label class=\"de-choice\"><input type=\"checkbox\" class=\"de-checkbox\"><span>Save as default for new projects</span></label>\n    <div class=\"de-row\">\n      <button type=\"button\" class=\"de-button de-button--secondary de-button--m\">Cancel</button>\n      <button type=\"button\" class=\"de-button de-button--primary de-button--m\">Apply &amp; OK</button>\n    </div>\n  </div>\n</div>"
    },
    {
      "id": "studio-tool-panel",
      "no": "S4",
      "name": "无顶栏纯工具窗脚手架 (Tool Window / .de-studio)",
      "pixsoSource": "【NewUI】Learn tool window (460×891) & icon.pix Studio Tool Menu",
      "whenToUse": "无顶栏的独立侧边工具面板、插件停靠面板（唯一合法使用 .de-studio 横向容器的场景，严禁放 .de-titlebar）",
      "defaultSystem": "pc-mac",
      "defaultTheme": "dark",
      "structure": ".de-window.de-studio > .de-stripe + .de-nav + .de-main",
      "html": "<section class=\"de-window de-studio\" style=\"min-height:230px\">\n  <nav class=\"de-stripe\" aria-label=\"工具条\">\n    <button type=\"button\" class=\"de-icon-button de-icon-button--m\" aria-label=\"提交\" aria-pressed=\"true\"><svg class=\"de-svg-icon\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-工具栏-ic-ide-commit\"/></svg></button>\n    <button type=\"button\" class=\"de-icon-button de-icon-button--m\" aria-label=\"Bookmarks\"><svg class=\"de-svg-icon\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-ic-ide-bookmark\"/></svg></button>\n    <button type=\"button\" class=\"de-icon-button de-icon-button--m\" aria-label=\"Terminal\"><svg class=\"de-svg-icon\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-工具栏-ic-ide-terminal\"/></svg></button>\n  </nav>\n  <aside class=\"de-nav\" aria-label=\"工具菜单\" style=\"width:220px\">\n    <div class=\"de-nav__label\">Tool Windows</div>\n    <button type=\"button\" class=\"de-nav__item\" aria-current=\"page\"><svg class=\"de-svg-icon de-svg-icon--s\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-工具栏-ic-ide-commit\"/></svg><span class=\"de-nav__text\">Commit &amp; Changes</span><span class=\"de-counter\">4</span></button>\n    <button type=\"button\" class=\"de-nav__item\"><svg class=\"de-svg-icon de-svg-icon--s\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-ic-ide-bookmark\"/></svg><span class=\"de-nav__text\">Bookmarks</span></button>\n    <button type=\"button\" class=\"de-nav__item\"><svg class=\"de-svg-icon de-svg-icon--s\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#hm-工具栏-ic-ide-terminal\"/></svg><span class=\"de-nav__text\">Terminal</span></button>\n  </aside>\n  <div class=\"de-main\" style=\"padding:14px 16px;gap:10px\">\n    <div class=\"de-toolbar\" style=\"padding:0;min-height:28px;background:transparent\"><span class=\"de-toolbar__title\">Changes (4 files)</span><span class=\"de-tag\">feat/ai-agent</span></div>\n    <div class=\"de-banner\" data-tone=\"info\"><span class=\"de-banner__body\">当前为无顶栏纯工具窗模式（.de-studio），适合嵌入独立停靠面板。</span></div>\n  </div>\n</section>"
    },
    {
      "id": "welcome-screen",
      "no": "S5",
      "name": "工程欢迎页脚手架 (Welcome Screen)",
      "pixsoSource": "【NewUI】Welcome Screen (797×649)",
      "whenToUse": "IDE 冷启动欢迎页、最近工程管理、插件中心与新建/导入工程入口",
      "defaultSystem": "harmony",
      "defaultTheme": "light",
      "structure": ".de-welcome > .de-welcome__sidebar(.de-welcome__brand + .de-nav__item*) + .de-welcome__main(.de-row + .de-welcome__row*)",
      "html": "<section class=\"de-welcome\" aria-label=\"Welcome to DevEco Studio\">\n  <aside class=\"de-welcome__sidebar\">\n    <div class=\"de-welcome__brand\">\n      <span class=\"de-titlebar__mark\">A</span>\n      <div><strong style=\"display:block;font-size:13px\">DevEco Studio</strong><span style=\"font-size:11px;color:var(--text-tertiary)\">NEXT 6.0</span></div>\n    </div>\n    <button type=\"button\" class=\"de-nav__item\" aria-current=\"page\"><span class=\"de-nav__text\">Projects</span></button>\n    <button type=\"button\" class=\"de-nav__item\"><span class=\"de-nav__text\">Customize</span></button>\n    <button type=\"button\" class=\"de-nav__item\"><span class=\"de-nav__text\">Plugins</span></button>\n    <button type=\"button\" class=\"de-nav__item\"><span class=\"de-nav__text\">Learn DevEco</span></button>\n  </aside>\n  <div class=\"de-welcome__main\">\n    <div class=\"de-row\" style=\"justify-content:space-between\">\n      <label class=\"de-search\" style=\"flex:1;max-width:280px\"><span class=\"de-icon\"><svg class=\"de-svg-icon de-svg-icon--s\" aria-hidden=\"true\"><use href=\"../icons/sprite.svg#nu-general-search\"/></svg></span><input type=\"search\" placeholder=\"Search projects...\" aria-label=\"搜索工程\"></label>\n      <div class=\"de-row\">\n        <button type=\"button\" class=\"de-button de-button--primary de-button--s\">New Project</button>\n        <button type=\"button\" class=\"de-button de-button--secondary de-button--s\">Open</button>\n      </div>\n    </div>\n    <div class=\"de-welcome__row\"><div><strong style=\"display:block;font-size:13px\">Healthy_life</strong><span style=\"font-size:11.5px;color:var(--text-tertiary)\">~/DevEcoStudioProjects/Healthy_life</span></div><span class=\"de-tag\">ArkTS 6.0</span></div>\n    <div class=\"de-welcome__row\"><div><strong style=\"display:block;font-size:13px\">SmartHome_2in1</strong><span style=\"font-size:11.5px;color:var(--text-tertiary)\">~/DevEcoStudioProjects/SmartHome_2in1</span></div><span class=\"de-tag\">Stage</span></div>\n  </div>\n</section>"
    }
