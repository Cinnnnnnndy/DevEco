s=\"de-split-pane__col\" style=\"flex:0.75\">\n      <div class=\"de-diff-head\"><span>ArkUI Previewer · Mate 70 Pro</span><span class=\"de-tag\">100%</span></div>\n      <div class=\"de-preview-canvas\">\n        <div class=\"de-preview-phone\">\n          <div style=\"display:flex;justify-content:space-between;align-items:center\"><strong style=\"font-size:13px\">健康卡片</strong><span class=\"de-tag\">实时</span></div>\n          <div style=\"font-size:20px;font-weight:700;color:var(--color-info)\">8,420 <span style=\"font-size:11px;font-weight:400;color:var(--text-tertiary)\">步</span></div>\n          <div class=\"de-progress\"><div class=\"de-progress__bar\" style=\"width:84%\"></div></div>\n          <button type=\"button\" class=\"de-button de-button--primary de-button--s\" style=\"width:100%\">查看详情</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
